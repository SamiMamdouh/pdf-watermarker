# Copy values into your host's secret environment variables.
# Alternatively run npm run setup to generate local credentials and .env.
APP_USERNAME=admin
# Set ONE of APP_PASSWORD or APP_PASSWORD_HASH. Use at least 12 characters.
APP_PASSWORD=
# APP_PASSWORD_HASH='scrypt$<salt>$<hash>'

# Production hosts must terminate HTTPS and forward requests to this Node app.
NODE_ENV=production
APP_ORIGIN=https://your-app.example.com
PORT=3000
# Only enable when a trusted reverse proxy appends or replaces X-Forwarded-For
# and the Node server cannot be reached except through that proxy.
TRUST_PROXY=false
